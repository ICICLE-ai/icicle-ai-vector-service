# --- Qdrant ---
# Append :443 if Qdrant sits behind an HTTPS proxy — the client defaults to 6333.
QDRANT_URL=
QDRANT_API_KEY=

# --- App ---
APP_ENV=

# --- Tapis Auth (ICICLE AI tenant) ---
TAPIS_ISSUER=
TAPIS_JWKS_URL=
TAPIS_TENANT_ID=

# --- CORS ---
# JSON array, e.g. ["https://portal.example.org"]. Defaults to ["*"].
ALLOWED_ORIGINS=

# --- Cross-encoder reranking (optional) ---
# Only used by POST /v1/rerank with method="cross_encoder". Requires the
# [rerank] extra; without it the service runs and that one method returns 503.
# Default model. bge-reranker-base is multilingual; swap to
# cross-encoder/ms-marco-MiniLM-L-6-v2 for ~6x lower latency on ENGLISH-ONLY corpora.
RERANK_MODEL=
# JSON array of models a request may select via "rerank_model".
RERANK_ALLOWED_MODELS=
# true loads the default model at startup instead of on the first request.
RERANK_PRELOAD=
# Torch intra-op threads. 0 lets torch decide from the cgroup CPU limit.
RERANK_THREADS=
# Hard cap on candidates scored per request (default 128).
RERANK_MAX_CANDIDATES=
# Token truncation length per (query, passage) pair (default 512).
RERANK_MAX_LENGTH=
